# SAP Datasphere — Interactive Usage OAuth
# Copy to .env and fill in values from System → Administration → App Integration

# OAuth client (Purpose: Interactive Usage, Grant: Authorization Code)
DSP_OAUTH_CLIENT_ID=
DSP_OAUTH_CLIENT_SECRET=
DSP_OAUTH_AUTHORIZE_URL=https://<tenant-uuid>.authentication.<region>.hana.ondemand.com/oauth/authorize
DSP_OAUTH_TOKEN_URL=https://<tenant-uuid>.authentication.<region>.hana.ondemand.com/oauth/token
DSP_OAUTH_REDIRECT_URI=http://localhost:8080/callback

# Tenant (use *.hcs.cloud.sap host — not the authentication host)
DSP_TENANT_URL=https://<tenant-uuid>.<region>.hcs.cloud.sap
DSP_TENANT_ID=

# Optional defaults when tools omit space_id / asset_id
DSP_SPACE_ID=
DSP_ASSET_ID=

# Safeguard: read-only by default. Invalid boolean values prevent startup.
DSP_ALLOW_READ=true
# WRITE includes object create/update (including deployment).
DSP_ALLOW_WRITE=false
DSP_ALLOW_DELETE=false
# Exact, case-sensitive Space IDs for WRITE and DELETE. Empty = none; no wildcard.
# Reads remain available across all SAP-authorized Spaces when READ=true.
# Example: DSP_ALLOWED_WRITE_SPACES=DEV_SPACE,TEST_SPACE
DSP_ALLOWED_WRITE_SPACES=

# Optional case-sensitive prefixes for object CREATE, UPDATE and DELETE in those Spaces.
# Empty = no name restriction. ABZ* and ABZ both mean starts with ABZ.
# Example: DSP_ALLOW_WRITE_OBJECT_PREFIXES=ABZ*,HRA,Z_TEAM_
# All object names in a submitted JSON payload must match.
DSP_ALLOW_WRITE_OBJECT_PREFIXES=

# Independent prefixes for object READ, catalog/search, metadata and OData queries.
# Empty = no read-name restriction. Example: ABZ*,HRA,SOURCE_
# WRITE prefixes do not grant READ access (and vice versa).
DSP_ALLOW_READ_OBJECT_PREFIXES=

# Official datasphere CLI (optional — only for datasphere_cli_status / datasphere_cli_run)
# Prefer path to terminal.js; datasphere.cmd is also accepted on Windows
# DSP_CLI_PATH=C:\Users\rybak\AppData\Roaming\npm\node_modules\@sap\datasphere-cli\terminal.js
DSP_CLI_TIMEOUT_SECONDS=120

# In-memory response cache (metadata, service docs, catalog lists)
DSP_CACHE_ENABLED=true
# OData query response cache (identical URLs, short TTL)
DSP_QUERY_CACHE_ENABLED=true
DSP_QUERY_CACHE_TTL_MS=120000
